PORT=3001
CORS_ORIGIN=http://localhost:5173

# OpenAI for vision analysis + listing generation.
# This is the GLOBAL fallback key. Users can also add their own key
# in the app's Settings page (stored per-user in Supabase).
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-4o-mini

# Supabase service role — REQUIRED for per-user settings (Settings page).
# Find these in Supabase dashboard → Project Settings → API.
# The service role key is a SECRET — never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — REQUIRED for emailing listings to yourself.
# Get a key at https://resend.com/api-keys (free tier: 100 emails/day).
# From email must be a verified domain, or use onboarding@resend.dev for testing.
RESEND_API_KEY=re_your-key-here
RESEND_FROM_EMAIL=Listings Assistant <onboarding@resend.dev>
