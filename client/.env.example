# Supabase project credentials (from your Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: API base URL for the Express server.
# Leave empty in dev — Vite proxies /api to http://localhost:3001 (see vite.config.ts).
# Set this in production if the API is hosted separately from the client.
VITE_API_URL=