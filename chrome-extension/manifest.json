{
  "manifest_version": 3,
  "name": "Listings Assistant",
  "version": "1.1.0",
  "description": "Fill Vinted and Depop listing forms from your Listings Assistant queue",
  "permissions": ["storage", "alarms", "activeTab", "tabs", "downloads"],
  "host_permissions": [
    "https://www.vinted.co.uk/*",
    "https://www.vinted.com/*",
    "https://www.vinted.fr/*",
    "https://www.vinted.de/*",
    "https://www.vinted.ie/*",
    "https://www.vinted.be/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.es/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.pl/*",
    "https://www.depop.com/*",
    "https://www.ebay.co.uk/*",
    "https://www.ebay.com/*",
    "https://*.railway.app/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Listings Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.co.uk/items/new*",
        "https://www.vinted.com/items/new*",
        "https://www.vinted.fr/items/new*",
        "https://www.vinted.de/items/new*",
        "https://www.vinted.ie/items/new*"
      ],
      "js": ["src/content/content.ts"],
      "css": ["src/content/sidebar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.depop.com/products/create*",
        "https://www.depop.com/products/edit*",
        "https://www.depop.com/sell*"
      ],
      "js": ["src/content/depop.ts"],
      "css": ["src/content/sidebar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.co.uk/sell*",
        "https://www.ebay.co.uk/lst/sell*",
        "https://www.ebay.com/sell*",
        "https://www.ebay.com/lst/sell*"
      ],
      "js": ["src/content/ebay.ts"],
      "css": ["src/content/sidebar.css"],
      "run_at": "document_idle"
    }
  ]
}
